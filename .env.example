# ── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── Database Configuration ───────────────────────────────────────────────────
DATABASE_URL=postgresql://careconnect_user:secure_password@localhost:5432/careconnect_dev?sslmode=require

# ── JWT Configuration ────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-must-be-32-chars-minimum
JWT_REFRESH_SECRET=your-refresh-secret-must-also-be-at-least-32-chars-long
JWT_RESET_SECRET=your-reset-secret-must-also-be-at-least-32-chars-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-character-encryption-key!
HASH_SALT_ROUNDS=12

# ── Rwanda Specific ──────────────────────────────────────────────────────────
RWANDA_TIMEZONE=Africa/Kigali
DEFAULT_CURRENCY=RWF

# ── MTN Mobile Money ─────────────────────────────────────────────────────────
# Get credentials at: https://momodeveloper.mtn.com
# 1. Register, create a sandbox app
# 2. Subscribe to the Collection product
# 3. Generate API User and API Key via the sandbox provisioning API
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=your_collection_subscription_key_here
MTN_MOMO_API_USER_ID=your_api_user_id_here
MTN_MOMO_API_KEY=your_api_key_here
MTN_MOMO_ENVIRONMENT=sandbox

# ── Airtel Money ─────────────────────────────────────────────────────────────
# Get credentials at: https://developers.airtel.africa
# 1. Register and create an application
# 2. Obtain Client ID and Client Secret
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id_here
AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret_here
AIRTEL_MONEY_COUNTRY=RW
AIRTEL_MONEY_CURRENCY=RWF

# ── Payment Callback  ─────────────────────────────────────────────────────────
# The public URL where payment providers send webhook notifications
# Must be HTTPS and publicly accessible
PAYMENT_CALLBACK_URL=https://your-domain.com/api/v1/payments/webhook/mtn