# Copy to .env and fill in. Never commit .env. Production secrets belong in the secret manager.
# Generate secrets with openssl (values below are examples; replace every one):
#   openssl rand -hex 32   -> 64 characters, for JWT and VIDEO_TURN_SECRET
#   openssl rand -hex 16   -> exactly 32 characters, for ENCRYPTION_KEY

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
# Where the web app lives (used in password-reset links and CORS)
FRONTEND_URL=http://localhost:3001
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
# Docker (docker compose sets this for you): postgres://careconnect:<POSTGRES_PASSWORD>@db:5432/careconnect
# Hosted Postgres (for example Neon): use its URL and DATABASE_SSL=require
DATABASE_URL=postgres://careconnect:careconnect-dev@localhost:5432/careconnect
DATABASE_SSL=disable

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_RESET_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
# Optional. Changing these signs out everyone, so set them once before the first pilot user.
JWT_ISSUER=careconnect-bn
JWT_AUDIENCE=careconnect-api

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=exactly-32-characters-long-key!!
HASH_SALT_ROUNDS=12

# ── Rwanda ───────────────────────────────────────────────────────────────────
RWANDA_TIMEZONE=Africa/Kigali
DEFAULT_CURRENCY=RWF

# ── Pesapal (payments) ───────────────────────────────────────────────────────
# Credentials from the Pesapal merchant dashboard. Sandbox first.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Public URL of the IPN endpoint (must be HTTPS in production)
PESAPAL_IPN_URL=https://api.isanomed.org/api/v1/payments/webhook/pesapal
# Filled once by running: npm run pesapal:register-ipn (prints the value to paste here)
PESAPAL_IPN_ID=
# Where Pesapal sends the patient after checkout (the web app's return page)
PESAPAL_CALLBACK_URL=https://your-web-domain/patient/invoices/return
# Keep false until refund request fields are confirmed in the Pesapal sandbox.
# While false, refunds are processed by hand in the Pesapal dashboard.
PESAPAL_REFUNDS_ENABLED=false
# Hours between automatic reconciliation runs against Pesapal (0 disables the schedule)
RECONCILIATION_INTERVAL_HOURS=24

# ── Resend (email) ───────────────────────────────────────────────────────────
# The sender domain must be verified in Resend (DNS records) before emails are delivered.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="IsanoMed <no-reply@isanomed.org>"
RESEND_REPLY_TO=support@isanomed.org
# Signing secret of the webhook endpoint (/api/v1/webhooks/resend), used for bounce and complaint events
RESEND_WEBHOOK_SECRET=

# ── Video consultations (internal WebRTC + coturn) ───────────────────────────
# Shared with the coturn container (docker compose passes it there). Use a random string of 32+ characters.
VIDEO_TURN_SECRET=
# Public IP of the server. Required in production; leave empty for local development.
VIDEO_PUBLIC_IP=
# Host name browsers use for TURN over TLS on port 443. The reverse proxy (Traefik/Coolify) routes it to coturn
# and gets its certificate. It must resolve to the server, e.g. turn.<public-ip>.sslip.io or turn.your-domain.
VIDEO_TURN_DOMAIN=
# Docker network of the reverse proxy; coturn joins it so the proxy can reach it. Coolify: coolify (default).
# Local docker compose: create it once with  docker network create coolify
PROXY_NETWORK=coolify
# UDP ports coturn relays media on inside its container (each relayed call uses about 2).
VIDEO_RELAY_MIN_PORT=49152
VIDEO_RELAY_MAX_PORT=65535
# STUN and TURN addresses the browser uses.
# Local development: coturn on localhost:3478.
# Production (only 80/443 reach the server): leave VIDEO_STUN_URLS empty and use TURN over TLS:
#   VIDEO_STUN_URLS=
#   VIDEO_TURN_URLS=turns:<VIDEO_TURN_DOMAIN>:443?transport=tcp
VIDEO_STUN_URLS=stun:localhost:3478
VIDEO_TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Join window around the appointment time, in minutes
VIDEO_JOIN_WINDOW_BEFORE_MIN=15
VIDEO_JOIN_WINDOW_AFTER_MIN=30

# ── Demo accounts ────────────────────────────────────────────────────────────
# true: every deploy creates (or re-activates) the shared demo accounts after migrating (see docs/DEPLOYMENT.md).
# Set false before real launch, then suspend them once: node dist/db/seed-demo.js --disable
SEED_DEMO_ACCOUNTS=false

# ── Checking the keys ────────────────────────────────────────────────────────
# After filling in the keys, run: npm run check:integrations
# It reports which integrations are ready and makes one live call per configured provider.
