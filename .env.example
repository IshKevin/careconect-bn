# Copy to .env and fill in. Never commit .env. Production secrets belong in the secret manager.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
# Where the web app lives (used in password-reset links and CORS)
FRONTEND_URL=http://localhost:3001
# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3001

# ── Database ─────────────────────────────────────────────────────────────────
# Docker (docker compose sets this for you): postgres://careconnect:<POSTGRES_PASSWORD>@db:5432/careconnect
# Hosted Postgres (for example Neon): use its URL and DATABASE_SSL=require
DATABASE_URL=postgres://careconnect:careconnect-dev@localhost:5432/careconnect
DATABASE_SSL=disable

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_RESET_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── Encryption ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=exactly-32-characters-long-key!!
HASH_SALT_ROUNDS=12

# ── Rwanda ───────────────────────────────────────────────────────────────────
RWANDA_TIMEZONE=Africa/Kigali
DEFAULT_CURRENCY=RWF

# ── Pesapal (payments) ───────────────────────────────────────────────────────
# Credentials from the Pesapal merchant dashboard. Sandbox first.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Public URL of the IPN endpoint (must be HTTPS in production)
PESAPAL_IPN_URL=https://your-api-domain/api/v1/payments/webhook/pesapal
# Filled after running the IPN registration once (see docs/roadmap/01-payment-gateway.md)
PESAPAL_IPN_ID=
# Where Pesapal sends the patient after checkout (the web app's return page)
PESAPAL_CALLBACK_URL=https://your-web-domain/patient/invoices/return

# ── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS="CareConnect <no-reply@your-domain>"
RESEND_REPLY_TO=support@your-domain
RESEND_WEBHOOK_SECRET=

# ── Video consultations (internal WebRTC + coturn) ───────────────────────────
# Shared with the coturn container. Use a random string of 32+ characters.
VIDEO_TURN_SECRET=
# STUN and TURN addresses the browser uses. Use the public host of the coturn server in production.
VIDEO_STUN_URLS=stun:coturn:3478
VIDEO_TURN_URLS=turn:coturn:3478?transport=udp
# Join window around the appointment time, in minutes
VIDEO_JOIN_WINDOW_BEFORE_MIN=15
VIDEO_JOIN_WINDOW_AFTER_MIN=30
